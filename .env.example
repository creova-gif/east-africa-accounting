# Copy this file to .env.local and replace the placeholder.
# .env and .env.local are gitignored. Never commit a real token.
#
# WARNING: VITE_ variables are embedded in the client bundle. A Figma PAT in
# VITE_FIGMA_ACCESS_TOKEN is recoverable by anyone who can load a configured
# build. Use a short-lived local-dev token only; rotate after use. Do not ship
# production builds with this value set. Server-side Figma proxy is the follow-up.
#
# Create a Figma personal access token at https://www.figma.com/settings
# then restart `npm run dev`.
# Read by src/services/figma.service.ts via import.meta.env.VITE_FIGMA_ACCESS_TOKEN.

VITE_FIGMA_ACCESS_TOKEN=your_figma_personal_access_token
